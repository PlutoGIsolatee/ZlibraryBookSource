        "action": "Login()",
        "style": {
            "layout_flexGrow": 1,
            "layout_flexShrink": 1,
            "layout_alignSelf": "auto",
            "layout_flexBasisPercent": -1,
            "layout_wrapBefore": true
        }
    },
    {
        "name": "sendCode",
        "viewName": "'📨发送注册验证码'",
        "type": "button",
        "action": "sendCode()",
        "style": {
            "layout_flexGrow": 1,
            "layout_flexShrink": 1,
            "layout_alignSelf": "auto",
            "layout_flexBasisPercent": -1,
            "layout_wrapBefore": true
        }
    },
    {
        "name": "register",
        "viewName": "'🪪注册（须验证码）'",
        "type": "button",
        "action": "register()",
        "style": {
            "layout_flexGrow": 1,
            "layout_flexShrink": 1,
            "layout_alignSelf": "auto",
            "layout_flexBasisPercent": -1,
            "layout_wrapBefore": false
        }
    },
    {
        "name": "searchOptions",
        "viewName": "'搜索选项'",
        "type": "button",
        "style": {
            "layout_flexGrow": 10,
            "layout_flexShrink": 1,
            "layout_alignSelf": "auto",
            "layout_flexBasisPercent": -1,
            "layout_wrapBefore": true
        }
    },
    {
        "name": "accurate",
        "viewName": "'精确对应'",
        "type": "toggle",
        "chars": [
            "🔲",
            "✅"
        ],
        "default": "🔲",
        "style": {
            "layout_flexGrow": 0,
            "layout_flexShrink": 1,
            "layout_alignSelf": "auto",
            "layout_flexBasisPercent": -1,
            "layout_wrapBefore": true
        }
    },{
