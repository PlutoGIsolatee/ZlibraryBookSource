[
    {
        "name": "domain",
        "viewName": "'镜像网址，形如https://xxxx/'",
        "type": "text",
        "action": "checkURLInput()"
    },
    {
        "name": "email",
        "viewName": "'邮箱'",
        "type": "text"
    },
    {
        "name": "password",
        "viewName": "'密码'",
        "type": "password"
    },
    {
        "name": "verifyCode",
        "viewName": "'验证码'",
        "type": "text"
    },
    {
        "name": "nickname",
        "viewName": "'昵称'",
        "type": "text"
    },
    {
        "name": "filterKeywords",
        "viewName": "'过滤关键词，形如：[\"关键字1\", \"关键字2\"]'",
        "type": "text",
        "default": "[\"成功学\", \"厚黑学\"]",
        "action": "checkJSONInput()"
    },
    {
        "name": "enterSite",
        "viewName": "'🌐打开网站主页'",
        "type": "button",
        "action": "enterSite()",
        "style": {
            "layout_flexGrow": 10,
            "layout_flexShrink": 1,
            "layout_alignSelf": "auto",
            "layout_flexBasisPercent": -1,
            "layout_wrapBefore": false
        }
    },
    {
        "name": "enterCurrent",
        "viewName": "'🌐打开当前书籍网页'",
        "type": "button",
        "action": "enterCurrent()",
        "style": {
            "layout_flexGrow": 1,
            "layout_flexShrink": 1,
            "layout_alignSelf": "auto",
            "layout_flexBasisPercent": -1,
            "layout_wrapBefore": false
        }
    },
    {
        "name": "switchDomain",
        "viewName": "'🔄切换网址'",
