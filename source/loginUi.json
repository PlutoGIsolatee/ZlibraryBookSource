        "action": "java.openUrl('legado://import/bookSource?src=https://pc.sysbbs.com/source/plugin/bphp_clouds/upload/29991/20251117/636e7a33e9a0e8a02a135fc4ff1d1591.json')",
        "style": {
            "layout_flexGrow": 1,
